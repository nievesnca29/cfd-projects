FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// PIMPLE algorithm (guide Section 2.7 - unsteady state)

solvers
{
    "alpha.water.*"
    {
        nAlphaCorr          2;
        // nAlphaSubCycles must be 1 when using CrankNicolson (OF9 limitation).
        // Stability is achieved via nLimiterIter instead.
        nAlphaSubCycles     1;
        cAlpha              1;

        MULESCorr           yes;
        nLimiterIter        8;

        solver              smoothSolver;
        smoother            symGaussSeidel;
        tolerance           1e-8;
        relTol              0;
    }

    pcorr
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-5;
        relTol          0;
    }

    pcorrFinal
    {
        $pcorr;
        relTol          0;
    }

    p_rgh
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-7;
        relTol          0.05;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0;
    }

    UFinal { $U; relTol 0; }

    k
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-7;
        relTol          0;
    }

    kFinal { $k; relTol 0; }

    omega
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-7;
        relTol          0;
    }

    omegaFinal { $omega; relTol 0; }
}

PIMPLE
{
    momentumPredictor       yes;
    nOuterCorrectors        3;
    nCorrectors             2;
    nNonOrthogonalCorrectors 2;
}

relaxationFactors
{
    equations
    {
        ".*"    1;
    }
}

