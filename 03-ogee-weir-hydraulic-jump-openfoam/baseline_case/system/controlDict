FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     interFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         15;

deltaT          0.0001;

writeControl    adjustableRunTime;
writeInterval   0.5;

purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable yes;

// Adaptive timestep (guide Section 2.7: Co <= 0.3)
adjustTimeStep  yes;
maxCo           0.3;
maxAlphaCo      0.3;
maxDeltaT       0.001;

functions
{
    // Monitor average TKE for convergence (guide Section 2.8)
    averageTKE
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        fields          (k);
        operation       volAverage;
        regionType      all;
        writeFields     false;
        writeControl    timeStep;
        writeInterval   10;
    }

    // Monitor average alpha for convergence
    averageAlpha
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        fields          (alpha.water);
        operation       volAverage;
        regionType      all;
        writeFields     false;
        writeControl    timeStep;
        writeInterval   10;
    }

    // Vertical sampling lines for flow depth (guide Section 2.8)
    // Y is the vertical axis in this case.
    sampleLines
    {
        type            sets;
        libs            ("libsampling.so");
        writeControl    adjustableRunTime;
        writeInterval   0.5;
        interpolationScheme cellPoint;
        setFormat       raw;
        fields          ( alpha.water U p_rgh k );
        sets
        (
            x_m05
            {
                type    lineUniform;
                axis    y;
                start   (-0.500  0.0     0.0);
                end     (-0.500  0.2925  0.0);
                nPoints 60;
            }
            x_000
            {
                type    lineUniform;
                axis    y;
                start   ( 0.010  0.118   0.0);
                end     ( 0.010  0.2925  0.0);
                nPoints 40;
            }
            x_p05
            {
                type    lineUniform;
                axis    y;
                start   ( 0.500  0.0     0.0);
                end     ( 0.500  0.2925  0.0);
                nPoints 60;
            }
            x_p10
            {
                type    lineUniform;
                axis    y;
                start   ( 1.000  0.0     0.0);
                end     ( 1.000  0.2925  0.0);
                nPoints 60;
            }
        );
    }
}

