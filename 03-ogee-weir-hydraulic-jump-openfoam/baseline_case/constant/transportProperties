FoamFile
{
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Fluid properties (guide Section 2.5)

phases (water air);

water
{
    transportModel  Newtonian;
    nu              1e-06;   // kinematic viscosity [m^2/s]
    rho             1000;    // density [kg/m^3]
}

air
{
    transportModel  Newtonian;
    nu              1.5e-05; // kinematic viscosity [m^2/s]
    rho             1.25;    // density [kg/m^3]
}

sigma           0.07;        // surface tension [N/m]

